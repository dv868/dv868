      "parameters": {
        "responseBody": "={{`<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"/><title>Prompt 优化器</title><style>body{font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,\"Helvetica Neue\",Arial;max-width:820px;margin:40px auto;padding:0 16px;line-height:1.6}h1,h2{line-height:1.25}textarea,input,button,select{font-size:16px}textarea{width:100%;box-sizing:border-box}button{padding:8px 14px;margin-right:12px}</style></head><body><h1>多模型 Prompt 优化与回答</h1><p>请输入你的消息，然后点击提交。</p><form method=\"post\" action=\"/webhook/multi-model-prompt/submit\"><textarea name=\"message\" rows=\"8\" placeholder=\"在此输入你的消息...\"></textarea><div style=\"margin-top:12px\"><button type=\"submit\">提交</button></div></form></body></html>`}}"
      },
      "name": "Show Input Form",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "multi-model-prompt/submit",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Receive Message (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "message",
              "value": "={{$json.body.message}}"
            },
            {
              "name": "runId",
              "value": "={{$execution.id}}"
            }
          ]
        }
      },
      "name": "Initial Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        460,
        400
      ]
    },
    {
      "parameters": {
        "responseBody": "={{`<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"/><title>选择优化模型</title><style>body{font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,\"Helvetica Neue\",Arial;max-width:820px;margin:40px auto;padding:0 16px;line-height:1.6}pre{white-space:pre-wrap;background:#f6f8fa;padding:12px;border-radius:6px}button{padding:8px 14px;margin-right:12px}</style></head><body><h2>步骤 1：选择用于优化的模型</h2><p><strong>原始消息：</strong></p><pre>${$json.message}</pre><form method=\"post\" action=\"/webhook/multi-model-prompt/choose-optimizer\"><input type=\"hidden\" name=\"optimizer\" value=\"gpt\"/><button type=\"submit\">使用 GPT 优化</button></form><form method=\"post\" action=\"/webhook/multi-model-prompt/choose-optimizer\" style=\"margin-top:8px\"><input type=\"hidden\" name=\"optimizer\" value=\"gemini\"/><button type=\"submit\">使用 Gemini 优化</button></form></body></html>`}}"
      },
      "name": "Choose Optimizer (Respond)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
