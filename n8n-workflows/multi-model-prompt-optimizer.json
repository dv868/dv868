            {
              "name": "userText",
              "value": "={{$item(0).$node['Initial Message'].json.message}}"
            },
            {
              "name": "optimizerModel",
              "value": "={{$json.body.optimizer}}"
            }
          ]
        }
      },
      "name": "Collect Step 1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
