        "bodyParametersJson": "={{ ({ model: 'gpt-4o', messages: [ { role: 'system', content: 'You are a prompt optimizer. Rewrite and enhance the user prompt to improve clarity, completeness, and effectiveness for LLMs. Return only the optimized prompt without any explanation.' }, { role: 'user', content: $json.userText } ], temperature: 0.2 }) }}"
      },
      "name": "OpenAI Optimize",
